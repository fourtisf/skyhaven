# ─────────────────────────────────────────────────────────────
# Skyhaven environment — copy to .env and fill in.
# Phase 0: only the service ports + infra URLs are needed.
# Chain/token values (Helius, treasury, SPL mint) land in Phase 5/6.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development

# Service ports
WEB_PORT=3000
API_PORT=4000
REALTIME_PORT=2567

# Cross-service URLs (used by the web shell + client)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567

# Infra (see docker-compose.yml)
DATABASE_URL=postgresql://skyhaven:skyhaven@localhost:5432/skyhaven?schema=public
REDIS_URL=redis://localhost:6379

# ── Reserved for later phases (leave blank until then) ──
# HELIUS_API_KEY=
# SKY_MINT_ADDRESS=
# TREASURY_SECRET_KEY=
# SOLANA_CLUSTER=devnet
