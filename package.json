{
  "name": "volari",
  "version": "0.0.0",
  "private": true,
  "description": "Volari — sky-farm GameFi. Server-authoritative monorepo (Next.js + Phaser + Colyseus + Fastify + Prisma).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm run --parallel --stream -r dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r --if-present lint",
    "typecheck": "pnpm run -r --if-present typecheck",
    "db:generate": "pnpm --filter @volari/db generate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
